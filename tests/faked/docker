#!/usr/bin/env python3
"""Test double for the Docker CLI used by the Zagros `zagros` bash CLI tests.

THIS IS A TEST HARNESS, NOT PART OF THE PRODUCT. It emulates the exact
docker/compose/hostctl surfaces the CLI consumes so the CLI's own logic
(argument parsing, state handling, backup/restore flows, update/rollback)
can be exercised end-to-end on machines without a Docker daemon (CI smoke
tests, sandboxes). Real-VPS verification with actual containers is a
separate, complementary step.

Faithfulness rules:
  * container state machine (running / health) mirrors compose lifecycle;
  * `compose exec` into a stopped/missing container fails, like real docker;
  * hostctl payloads match app/platform/hostctl.py's real JSON contract
    ({"ok": true, ...payload} / {"ok": false, "error", "code"} plus the
    real exit codes 0/1/2/3/4);
  * core state transitions mirror the real panel: installing a core leaves
    it 'installed' until the panel next boots, which marks it 'running'.
"""
from __future__ import annotations

import hashlib
import json
import os
import pathlib
import sys
import time

STATE_DIR = pathlib.Path(os.environ.get("FAKE_DOCKER_STATE", "/tmp/zagros-fake-docker"))
STATE_DIR.mkdir(parents=True, exist_ok=True)
LOG = STATE_DIR / "invocations.jsonl"


def log_call(argv: list[str]) -> None:
    with LOG.open("a") as fh:
        fh.write(json.dumps({"t": time.time(), "argv": argv}) + "\n")


def load(name: str, default):
    p = STATE_DIR / name
    if p.exists():
        try:
            return json.loads(p.read_text())
        except Exception:
            return default
    return default


def save(name: str, obj) -> None:
    (STATE_DIR / name).write_text(json.dumps(obj, indent=1))


def env_true(name: str, default: str = "1") -> bool:
    return os.environ.get(name, default) not in ("0", "false", "no", "")


def out(s: str = "") -> None:
    sys.stdout.write(s + "\n")


def fail(msg: str = "", code: int = 1) -> "None":
    if msg:
        sys.stderr.write(msg + "\n")
    sys.exit(code)


# --------------------------------------------------------------------------- #
# container helpers
# --------------------------------------------------------------------------- #

def containers() -> dict:
    return load("containers.json", {})


def set_container(name: str, running: bool, healthy: bool | None = None) -> None:
    cs = containers()
    cs[name] = {"running": running,
                "healthy": (healthy if healthy is not None else running)}
    save("containers.json", cs)


def container_exists(name: str) -> bool:
    return name in containers()


def container_running(name: str) -> bool:
    return bool(containers().get(name, {}).get("running"))


def panel_boot_effects() -> None:
    """The real panel boots enabled+installed cores on startup → mark them
    running (this is what makes per-core lifecycle PANEL_OWNED afterwards)."""
    cores = load("cores.json", {})
    changed = False
    for cid, c in cores.items():
        if c.get("enabled", True) and c.get("state") == "installed":
            c["state"] = "running"
            changed = True
    if changed:
        save("cores.json", cores)


# --------------------------------------------------------------------------- #
# hostctl emulation (must mirror app/platform/hostctl.py)
# --------------------------------------------------------------------------- #

CORE_CAPS = {
    "xray": ["shadowsocks", "trojan", "vless", "vmess"],
    "sing-box": ["hysteria2", "shadowsocks", "trojan", "tuic", "vless"],
    "hysteria2": ["hysteria2"],
    "tuic": ["tuic"],
    "wireguard": ["wireguard"],
    "openvpn": ["openvpn"],
    "ssh": ["ssh"],
    "softether": ["softether"],
}


def hostctl_emit(payload: dict) -> None:
    out(json.dumps(payload))


def hostctl_fail(message: str, code: str, rc: int) -> "None":
    hostctl_emit({"ok": False, "error": message, "code": code})
    sys.exit(rc)


def fake_health_payload() -> dict:
    cores = load("cores.json", {})
    running = sum(1 for c in cores.values() if c.get("state") == "running")
    enabled = sum(1 for c in cores.values() if c.get("enabled", True))
    healthy = env_true("FAKE_HEALTHY") and env_true("FAKE_DB_UPTODATE")
    return {
        "ok": True, "command": "health",
        "healthy": healthy,
        "db": {"reachable": True, "driver": "sqlite",
               "up_to_date": env_true("FAKE_DB_UPTODATE"),
               "latency_ms": 0.5},
        "cores": {"installed": len(cores), "enabled": enabled,
                  "running": running},
        "elapsed_ms": 1.0,
    }


def handle_hostctl(argv: list[str]) -> "None":
    if not argv:
        hostctl_fail("no subcommand", "usage", 2)
    sub, rest = argv[0], argv[1:]

    def opt(name: str, default=None):
        return rest[rest.index(name) + 1] if name in rest else default

    def flag(name: str) -> bool:
        return name in rest

    if sub == "version":
        hostctl_emit({"ok": True, "command": "version",
                      "panel_version": os.environ.get("FAKE_PANEL_VERSION",
                                                      "1.0.0-alpha.3")})
        sys.exit(0)

    if sub == "health":
        hostctl_emit(fake_health_payload())
        sys.exit(0)

    if sub == "db-check":
        hostctl_emit({"ok": True, "command": "db_check",
                      "reachable": True, "driver": "sqlite",
                      "alembic_current": ["0002_legacy_schema"],
                      "alembic_heads": ["0002_legacy_schema"],
                      "up_to_date": env_true("FAKE_DB_UPTODATE"),
                      "latency_ms": 0.4})
        sys.exit(0)

    if sub == "db-backup-sqlite":
        out_path = opt("--out")
        url = opt("--url") or "sqlite:////var/lib/zagros/zagros.db"
        if not str(url).startswith("sqlite"):
            hostctl_fail(f"db-backup-sqlite only works for SQLite (got '{url}')",
                         "error", 1)
        # container path → host path through the /var/lib/zagros bind mount
        host_data = os.environ.get("ZAGROS_DATA", "/var/lib/zagros")
        out_path = host_data + out_path[len("/var/lib/zagros"):] \
            if out_path.startswith("/var/lib/zagros") else out_path
        pathlib.Path(out_path).parent.mkdir(parents=True, exist_ok=True)
        content = f"-- fake sqlite snapshot of {url}\n-- taken-at {time.time()}\n"
        pathlib.Path(out_path).write_text(content)
        hostctl_emit({"ok": True, "command": "db_backup_sqlite",
                      "database": str(url).split("///")[-1],
                      "backup": out_path, "bytes": len(content)})
        sys.exit(0)

    cores = load("cores.json", {})

    if sub == "cores-list":
        probe = not flag("--no-probe")
        listing = []
        for cid, c in sorted(cores.items()):
            entry = {
                "id": cid, "title": cid,
                "state": c.get("state", "installed"),
                "enabled": bool(c.get("enabled", True)),
                "capabilities": CORE_CAPS.get(cid, ["custom"]),
                "provides": [], "requires": [],
            }
            if probe:
                entry["health"] = "healthy" if c.get("state") == "running" else None
                entry["core_version"] = c.get("version")
            listing.append(entry)
        hostctl_emit({"ok": True, "command": "cores_list",
                      "cores": listing, "stored_without_driver": []})
        sys.exit(0)

    if sub == "cores-install":
        cid = rest[0]
        if cid not in CORE_CAPS:
            hostctl_fail(f"Unknown core '{cid}'. Available: {', '.join(sorted(CORE_CAPS))}",
                         "not_found", 4)
        version = None
        settings = opt("--settings")
        if settings:
            try:
                version = json.loads(settings).get("version")
            except Exception:
                version = None
        cores[cid] = {"state": "installed", "enabled": not flag("--disabled"),
                      "version": version}
        save("cores.json", cores)
        hostctl_emit({"ok": True, "command": "cores_install", "core": cid,
                      "state": "installed", "enabled": not flag("--disabled")})
        sys.exit(0)

    if sub == "cores-uninstall":
        cid = rest[0]
        if cid not in cores:
            hostctl_fail(f"Core '{cid}' is not installed.", "not_found", 4)
        running = cores[cid].get("state") == "running"
        if running and not flag("--force"):
            hostctl_fail("core is running under the panel; stop it first or pass "
                         "--force (a panel restart will follow to release the process)",
                         "PANEL_OWNED", 3)
        cores.pop(cid)
        save("cores.json", cores)
        hostctl_emit({"ok": True, "command": "cores_uninstall", "core": cid,
                      "uninstalled": True, "purged": flag("--purge"),
                      "dependencies": {}, "restart_required": running})
        sys.exit(0)

    if sub == "cores-update":
        cid = rest[0]
        if cid not in cores:
            hostctl_fail(f"Core '{cid}' is not installed.", "not_found", 4)
        new_version = opt("--version") or "2.0.0"
        cores[cid]["version"] = new_version
        save("cores.json", cores)
        hostctl_emit({"ok": True, "command": "cores_update", "core": cid,
                      "version": new_version,
                      "restart_required": cores[cid].get("state") == "running"})
        sys.exit(0)

    if sub in ("cores-start", "cores-stop", "cores-restart"):
        cid = rest[0]
        action = sub.split("-", 1)[1]
        if cid not in cores:
            hostctl_fail(f"Core '{cid}' is not installed.", "NOT_INSTALLED", 4)
        if cores[cid].get("state") == "running":
            hostctl_fail(f"core '{cid}' is RUNNING under the live panel process; "
                         "per-core hot control requires the panel — restart the "
                         "service (`zagros reload`) or stop the panel first",
                         "PANEL_OWNED", 3)
        if action == "start":
            if not cores[cid].get("enabled", True):
                hostctl_fail(f"core '{cid}' is disabled; enable it first", "error", 1)
            cores[cid]["state"] = "running"
        elif action == "stop":
            cores[cid]["state"] = "stopped"
        else:
            cores[cid]["state"] = "running"
        save("cores.json", cores)
        hostctl_emit({"ok": True, "command": f"cores_{action}", "core": cid,
                      "action": action, "id": cid, "title": cid,
                      "state": cores[cid]["state"], "enabled": True,
                      "capabilities": CORE_CAPS.get(cid, ["custom"]),
                      "health": "healthy", "core_version": cores[cid].get("version")})
        sys.exit(0)

    if sub in ("cores-enable", "cores-disable"):
        cid = rest[0]
        cores.setdefault(cid, {"state": "installed", "version": None})
        cores[cid]["enabled"] = sub == "cores-enable"
        save("cores.json", cores)
        hostctl_emit({"ok": True, "core": cid,
                      "enabled": sub == "cores-enable"})
        sys.exit(0)

    if sub == "cores-logs":
        cid = rest[0]
        if cid not in cores:
            hostctl_fail(f"Core '{cid}' is not installed.", "not_found", 4)
        hostctl_emit({"ok": True, "command": "cores_logs", "core": cid,
                      "lines": [f"fake log line for {cid}"], "count": 1})
        sys.exit(0)

    if sub == "nodes-list":
        hostctl_emit({"ok": True, "command": "nodes_list",
                      "nodes": load("nodes.json", [])})
        sys.exit(0)

    if sub == "sync":
        only = opt("--core")
        summary = {}
        for cid, c in cores.items():
            if only and cid != only:
                continue
            if not c.get("enabled", True):
                summary[cid] = {"synced": 0, "skipped": "disabled"}
            else:
                summary[cid] = {"synced": 0, "skipped_accounts": 0}
        hostctl_emit({"ok": True, "command": "sync", "cores": summary})
        sys.exit(0)

    admins = load("admins.json", {})
    if sub == "admin-list":
        hostctl_emit({"ok": True, "command": "admin_list",
                      "admins": [{"username": u, "is_sudo": a.get("is_sudo", False),
                                  "created_at": "2026-01-01 00:00:00"}
                                 for u, a in admins.items()]})
        sys.exit(0)
    if sub in ("admin-create", "admin-reset"):
        username = opt("--username")
        if sub == "admin-create":
            if username in admins:
                hostctl_fail(f"Admin '{username}' already exists.", "error", 1)
            admins[username] = {"is_sudo": flag("--sudo")}
            save("admins.json", admins)
            hostctl_emit({"ok": True, "command": "admin_create",
                          "username": username, "is_sudo": flag("--sudo"),
                          "created": True})
            sys.exit(0)
        if username not in admins:
            hostctl_fail(f"Admin '{username}' not found.", "not_found", 4)
        hostctl_emit({"ok": True, "command": "admin_reset", "username": username,
                      "password_reset": True,
                      "is_sudo": admins[username].get("is_sudo", False)})
        sys.exit(0)

    hostctl_fail(f"unknown hostctl subcommand {sub}", "usage", 2)


# --------------------------------------------------------------------------- #
# compose emulation
# --------------------------------------------------------------------------- #

ENV_REFS = ("--env-file", "-f")


def parse_compose_args(rest: list[str]):
    """Return (subcommand, tail, env_file, compose_file)."""
    env_file = compose_file = None
    idx = None
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok == "--env-file":
            env_file = rest[i + 1]; i += 2; continue
        if tok in ("-f", "--file"):
            compose_file = rest[i + 1]; i += 2; continue
        if tok == "--ansi":
            i += 2; continue
        if tok in ("config", "pull", "up", "down", "stop", "start", "restart",
                   "logs", "exec", "ps", "rm", "version", "images"):
            idx = i; break
        i += 1
    if idx is None:
        fail("fake compose: no subcommand in " + " ".join(rest))
    return rest[idx], rest[idx + 1:], env_file, compose_file


def env_file_tag(env_file: str | None) -> str:
    if env_file and pathlib.Path(env_file).exists():
        for line in pathlib.Path(env_file).read_text().splitlines():
            if line.startswith("ZAGROS_IMAGE_TAG="):
                return line.split("=", 1)[1].strip()
    return "latest"


def record_image(image_repo: str, tag: str) -> None:
    images = load("images.json", {})
    digest = "sha256:" + hashlib.sha256(f"fake:{image_repo}:{tag}".encode()).hexdigest()
    images[f"{image_repo}:{tag}"] = digest
    save("images.json", images)


def handle_compose(rest: list[str]) -> "None":
    sub, tail, env_file, _compose_file = parse_compose_args(rest)
    if sub == "version":
        out("Docker Compose version v2.32.4")
        sys.exit(0)
    if sub == "config":
        sys.exit(0)
    if sub == "pull":
        if not env_true("FAKE_COMPOSE_PULL_OK"):
            fail("fake: pull failed (FAKE_COMPOSE_PULL_OK=0)")
        tag = env_file_tag(env_file)
        record_image("ghcr.io/zagrosgm/zagros", tag)
        out(f"pulled ghcr.io/zagrosgm/zagros:{tag}")
        sys.exit(0)
    if sub in ("up", "start", "restart"):
        only = next((t for t in tail if not t.startswith("-")), None)
        if only in (None, "zagros"):
            set_container("zagros", True)
            panel_boot_effects()
        if only in (None, "zagros-db"):
            set_container("zagros-db", True)
        sys.exit(0)
    if sub in ("down",):
        save("containers.json", {})
        sys.exit(0)
    if sub == "stop":
        target = next((t for t in tail if not t.startswith("-")), None)
        if target:
            set_container(target, False)
        else:
            for name in list(containers()):
                set_container(name, False)
        sys.exit(0)
    if sub == "logs":
        out("fake panel log line")
        sys.exit(0)
    if sub == "ps":
        sys.exit(0)
    if sub == "rm":
        sys.exit(0)
    if sub == "images":
        sys.exit(0)
    if sub == "exec":
        args = [t for t in tail if t != "-T"]
        service = args[0]
        cmd = args[1:]
        if not container_running(service):
            sys.stderr.write(f"service \"{service}\" is not running\n")
            sys.exit(1)
        if cmd[:3] == ["python3", "-m", "app.platform.hostctl"]:
            handle_hostctl(cmd[3:])
        if cmd[:2] == ["python3", "-m"] and len(cmd) >= 3 and cmd[2] == "alembic":
            if not env_true("FAKE_ALEMBIC_OK"):
                fail("fake: alembic failed (FAKE_ALEMBIC_OK=0)")
            if "current" in cmd:
                out("0002_legacy_schema (head)")
            sys.exit(0)
        if cmd and cmd[0] in ("sh", "bash"):
            sys.exit(0)  # interactive shell with EOF stdin
        sys.exit(0)
    fail(f"fake compose: unhandled subcommand {sub}")


# --------------------------------------------------------------------------- #
# docker emulation
# --------------------------------------------------------------------------- #

def container_health(name: str) -> str:
    cs = containers()
    if name not in cs:
        fail(f"Error: No such object: {name}")
    c = cs[name]
    if c.get("running"):
        return "healthy" if c.get("healthy") else "running"
    return "exited"


def main() -> "None":
    argv = sys.argv[1:]
    log_call(argv)
    if not argv:
        fail("fake docker: no args")
    a0 = argv[0]

    if a0 in ("version", "--version", "-v"):
        out("Docker version 27.5.1, build fake")
        if a0 == "version" and "--format" in argv:
            pass  # already printed something sane
        sys.exit(0)
    if a0 == "info":
        out("Server Version: 27.5.1")
        sys.exit(0)
    if a0 == "compose":
        handle_compose(argv[1:])
    if a0 == "image":
        sub = argv[1]
        if sub == "inspect":
            ref = argv[2]
            rest = argv[3:]
            images = load("images.json", {})
            if ref not in images:
                fail(f"Error: No such image: {ref}")
            fmt = ""
            if "--format" in rest:
                fmt = rest[rest.index("--format") + 1]
            if "RepoDigests" in fmt:
                out(f"{ref.split(':')[0]}@{images[ref]}")
            else:
                out("[{}]")
            sys.exit(0)
        if sub == "prune":
            out("Total reclaimed space: 0B")
            sys.exit(0)
        if sub == "ls":
            sys.exit(0)
        fail(f"fake docker: unhandled image {sub}")
    if a0 == "images":
        repo = argv[1] if len(argv) > 1 and not argv[1].startswith("-") else None
        fmt = ""
        if "--format" in argv:
            fmt = argv[argv.index("--format") + 1]
        images = load("images.json", {})
        for ref, digest in sorted(images.items()):
            r, _, t = ref.partition(":")
            if repo and r != repo:
                continue
            if fmt == "{{.Repository}}:{{.Tag}} {{.Digest}}":
                out(f"{r}:{t} {digest}")
            elif fmt == "{{.Tag}}":
                out(t)
            elif "-q" in argv:
                out(hashlib.sha1(ref.encode()).hexdigest()[:12])
            else:
                out(f"{r} {t}")
        sys.exit(0)
    if a0 == "inspect":
        name = argv[-1]
        fmt = ""
        if "--format" in argv:
            fmt = argv[argv.index("--format") + 1]
        if not container_exists(name):
            fail(f"Error: No such object: {name}")
        if ".State" in fmt:
            status = container_health(name)
            if "container:" in fmt and ".State.Health" in fmt:
                out(status)
            else:
                out(status)
            sys.exit(0)
        out("[{}]")
        sys.exit(0)
    if a0 == "ps":
        fmt = ""
        if "--format" in argv:
            fmt = argv[argv.index("--format") + 1]
        name_filter = None
        for i, t in enumerate(argv):
            if t == "--filter" and i + 1 < len(argv) and argv[i + 1].startswith("name="):
                name_filter = argv[i + 1].split("=", 1)[1]
        rows = []
        for name, c in containers().items():
            if name_filter and name_filter not in name:
                continue
            if fmt.startswith("table"):
                rows.append(f"{name}\tUp 5 minutes (healthy)\tghcr.io/zagrosgm/zagros")
            elif fmt == "{{.Names}}":
                rows.append(name)
        if rows and fmt.startswith("table"):
            out("NAMES\tSTATUS\tIMAGE")
        for r in rows:
            out(r)
        sys.exit(0)
    if a0 in ("stop", "start", "rm"):
        for name in argv[1:]:
            if name.startswith("-"):
                continue
            if a0 == "stop":
                set_container(name, False)
            elif a0 == "start":
                if container_exists(name):
                    set_container(name, True)
            elif a0 == "rm":
                cs = containers(); cs.pop(name, None); save("containers.json", cs)
        sys.exit(0)
    if a0 == "pull":
        ref = argv[1]
        repo, _, tag = ref.partition(":")
        record_image(repo, tag or "latest")
        sys.exit(0)
    if a0 == "rmi":
        images = load("images.json", {})
        rc = 0
        for ref in argv[1:]:
            if ref.startswith("-"):
                continue
            if ref in images:
                images.pop(ref)
            elif ref:
                rc = 0  # idempotent like `|| true` callers expect
        save("images.json", images)
        sys.exit(rc)
    if a0 == "exec":
        # direct exec (db dumps / provisioning): flags before container name
        i = 1
        while i < len(argv) and argv[i].startswith("-"):
            if argv[i] == "-e":
                i += 2
            else:
                i += 1
        if i >= len(argv):
            fail("fake docker exec: no container")
        container = argv[i]
        cmd = argv[i + 1:]
        if not container_running(container):
            fail(f"Error response from daemon: container {container} is not running")
        prog = cmd[0] if cmd else ""
        if prog == "mysqldump":
            out("-- fake mysqldump\nCREATE DATABASE IF NOT EXISTS zagros;\n")
        elif prog == "pg_dump":
            sys.stdout.buffer.write(b"PGDMPFAKE\n")
        elif prog in ("mysql", "psql", "pg_restore", "mysqladmin"):
            try:
                sys.stdin.read()
            except Exception:
                pass
        elif prog in ("sh", "bash"):
            pass
        sys.exit(0)
    if a0 == "run":
        sys.exit(0)
    if a0 == "system":
        out("Total reclaimed space: 0B")
        sys.exit(0)
    if a0 == "network":
        sys.exit(0)
    # unknown subcommands: succeed quietly (harness lenient by design)
    sys.exit(0)


if __name__ == "__main__":
    main()
