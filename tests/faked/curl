#!/usr/bin/env bash
# Test double for curl: serves zagros-scripts repo files from the LOCAL
# checkout (so the bootstrap path `zagros.sh → zagros` is tested without a
# network fetch of a possibly-not-yet-pushed file) and transparently passes
# every other URL through to the real curl.
out=""
url=""
args=()
while (($#)); do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
url="${args[-1]:-}"
case "$url" in
    https://raw.githubusercontent.com/ZagrosGM/zagros-scripts/*/zagros|https://raw.githubusercontent.com/ZagrosGM/zagros-scripts/*/zagros.sh)
        file="${url##*/}"
        src="$ZAGROS_TESTS_REPO_ROOT/$file"
        [[ -r "$src" ]] || exit 22   # simulate HTTP 404 like curl -f
        if [[ -n "$out" ]]; then cat "$src" > "$out"; else cat "$src"; fi
        ;;
    *)
        real=(/usr/bin/curl "${args[@]}")
        [[ -n "$out" ]] && real+=(-o "$out")
        exec "${real[@]}"
        ;;
esac
