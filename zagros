# `cores` groups the four per-core commands so the top level reads like the
# things you do to a panel, not like a list of API calls.
cmd_cores() {
    local sub="${1:-list}"
    [[ $# -gt 0 ]] && shift || true
    case "$sub" in
        list|ls)                cmd_list_cores "$@" ;;
        install|add)            cmd_install_core "$@" ;;
        update|upgrade)         cmd_update_core "$@" ;;
        uninstall|remove|rm)    cmd_uninstall_core "$@" ;;
        reload|restart)         cmd_reload_core "$@" ;;
        -h|--help|help)
            cat <<EOF
${C_BLD}zagros cores${C_RST} <action> [core] [options]

  ${C_BLU}list${C_RST}                      ${C_PNK}installed cores: state, version, health${C_RST}
  ${C_BLU}install${C_RST} ${C_DIM}<core>${C_RST}            ${C_PNK}SELF_INSTALL an official core binary${C_RST}
  ${C_BLU}update${C_RST} ${C_DIM}<core>${C_RST}             ${C_PNK}update a core — --version X pins one release${C_RST}
  ${C_BLU}uninstall${C_RST} ${C_DIM}<core>${C_RST}          ${C_PNK}dependency-checked removal (--purge/--force)${C_RST}
  ${C_BLU}reload${C_RST} ${C_DIM}<core>${C_RST}             ${C_PNK}restart a single core (panel-aware)${C_RST}
EOF
            ;;
        *) log_err "unknown cores action: $sub"; echo; cmd_cores help; exit 2 ;;
    esac
}

# The .env is the single source of truth; `env` is the short way to reach the
# same viewer/editor that `config` exposes.
cmd_env() {
    local sub="${1:-show}"
    [[ $# -gt 0 ]] && shift || true
    case "$sub" in
        -h|--help|help)
            cat <<EOF
${C_BLD}zagros env${C_RST} <action> [args]

  ${C_BLU}show${C_RST}                      ${C_PNK}show the effective config (masked secrets)${C_RST}
  ${C_BLU}edit${C_RST}                      ${C_PNK}open .env in \$EDITOR, then restart to apply${C_RST}
  ${C_BLU}get${C_RST} ${C_DIM}KEY${C_RST}                   ${C_PNK}print one value${C_RST}
  ${C_BLU}set${C_RST} ${C_DIM}KEY VALUE${C_RST}             ${C_PNK}write one value in place [--force] [--restart]${C_RST}
  ${C_BLU}validate${C_RST}                  ${C_PNK}sanity-check the .env${C_RST}
  ${C_BLU}path${C_RST}                      ${C_PNK}print the .env location${C_RST}
  ${C_BLU}reload${C_RST}                    ${C_PNK}validate + restart (applies .env immediately)${C_RST}
EOF
            ;;
        *) cmd_config "$sub" "$@" ;;
    esac
}

# Every command, reached either as `zagros <cmd>` or `zagros advanced <cmd>`.
# The advanced door only exists to keep the front page about running a panel.
dispatch() {
    local cmd="$1"; shift
    case "$cmd" in
        install)          cmd_install "$@" ;;
        uninstall)        cmd_uninstall "$@" ;;
        update)           cmd_update "$@" ;;
        rollback)         cmd_rollback "$@" ;;
        up)               cmd_up "$@" ;;
        down)             cmd_down "$@" ;;
        start)            cmd_start "$@" ;;
        stop)             cmd_stop "$@" ;;
        restart)          cmd_restart "$@" ;;
        reload)           cmd_reload "$@" ;;
        status)           cmd_status "$@" ;;
        logs)             cmd_logs "$@" ;;
        shell)            cmd_shell "$@" ;;
        health)           cmd_health "$@" ;;
        doctor)           cmd_doctor "$@" ;;
        repair)           cmd_repair "$@" ;;
        version)          cmd_version "$@" ;;
        backup)           cmd_backup "$@" ;;
        backup-service)   cmd_backup_service "$@" ;;
        restore)          cmd_restore "$@" ;;
        migrate)          cmd_migrate "$@" ;;
        config)           cmd_config "$@" ;;
        env)              cmd_env "$@" ;;
        cores)            cmd_cores "$@" ;;
        create-admin)     cmd_create_admin "$@" ;;
        reset-admin)      cmd_reset_admin "$@" ;;
        install-host-agent) cmd_install_host_agent "$@" ;;
        list-cores)       cmd_list_cores "$@" ;;
        install-core)     cmd_install_core "$@" ;;
        uninstall-core)   cmd_uninstall_core "$@" ;;
        update-core)      cmd_update_core "$@" ;;
        reload-core)      cmd_reload_core "$@" ;;
        sync)             cmd_sync "$@" ;;
        clean)            cmd_clean "$@" ;;
        prune)            cmd_prune "$@" ;;
        help|--help|-h)   general_help ;;
        *) log_err "unknown command: $cmd"; echo; general_help; exit 2 ;;
    esac
}

# The commands that are not part of running a panel day to day.
advanced_main() {
    local cmd="${1:-help}"
    [[ $# -gt 0 ]] && shift || true
    case "$cmd" in
        -h|--help|help) advanced_help; return 0 ;;
        install|uninstall|rollback|start|stop|reload|shell|health|doctor|repair|\
        migrate|config|create-admin|reset-admin|install-host-agent|backup-service|\
        clean|prune|sync|list-cores|install-core|uninstall-core|update-core|reload-core) ;;
        *) log_err "'$cmd' is not an advanced command"; echo; advanced_help; exit 2 ;;
    esac
    dispatch "$cmd" "$@"
}

main() {
    local cmd="${1:-help}"
    [[ $# -gt 0 ]] && shift || true
    # Auto-migrate a legacy zagros.env → .env before ANY command touches the
    # configuration (idempotent, never fatal when not writable).
    migrate_env_file
    if [[ "$cmd" == "advanced" ]]; then
        advanced_main "$@"
        return $?
    fi
    dispatch "$cmd" "$@"
}

main "$@"
