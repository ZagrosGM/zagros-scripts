#!/usr/bin/env bash
# =============================================================================
#  Zagros — host management CLI
# =============================================================================
#  Enterprise Multi-Core VPN Management Platform
#  Repository: https://github.com/ZagrosGM/Zagros
#  Installer : https://github.com/ZagrosGM/zagros-scripts
#
#  Design goals:
#   * single self-contained file (installed to /usr/local/bin/zagros) —
#     it never depends on the scripts repository being present on disk;
#   * every operation is real: docker/compose for the service lifecycle,
#     `python3 -m app.platform.hostctl` inside the container for panel
#     operations (cores, admins, db, sync) — no mocks, no hidden state;
#   * no core has a special place: cores install at runtime via SELF_INSTALL;
#     this CLI knows nothing about any specific core's internals;
#   * honest reporting: failures surface with exit codes and messages,
#     nothing is simulated or silently skipped.
#
#  Layout (all overridable via environment for tests):
#   /opt/zagros          ZAGROS_HOME   compose file, env, CLI state
#   /var/lib/zagros      ZAGROS_DATA   panel data, cores, backups, logs
#   /usr/local/bin       ZAGROS_BIN    this CLI
#   /usr/local/libexec   ZAGROS_LIBEXEC root-only Panel Network host agent
# =============================================================================
set -euo pipefail

ZAGROS_CLI_VERSION="1.0.0-beta.6"
SCRIPTS_REPO_RAW="https://raw.githubusercontent.com/ZagrosGM/zagros-scripts"
PANEL_REPO="ZagrosGM/Zagros"
PANEL_API="https://api.github.com/repos/${PANEL_REPO}"
IMAGE_REPO="ghcr.io/zagrosgm/zagros"

ZAGROS_HOME="${ZAGROS_HOME:-/opt/zagros}"
ZAGROS_DATA="${ZAGROS_DATA:-/var/lib/zagros}"
ZAGROS_BIN="${ZAGROS_BIN:-/usr/local/bin}"
ZAGROS_LIBEXEC="${ZAGROS_LIBEXEC:-/usr/local/libexec}"
# Config leftovers outside the managed dirs (overridable for tests).
ZAGROS_ETC="${ZAGROS_ETC:-/etc/zagros}"
# Service/cron locations swept by the full uninstall (overridable for tests).
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"
CRON_D_DIR="${CRON_D_DIR:-/etc/cron.d}"
ZAGROS_SCRIPTS_REF="${ZAGROS_SCRIPTS_REF:-main}"
COMPOSE_FILE="$ZAGROS_HOME/docker-compose.yml"
# Configuration contract: ONE .env file is the single source of truth.
# docker compose only MOUNTS it into the container (no env injection), and
# the panel resolves it CWD-independently. A legacy zagros.env is migrated
# automatically (see migrate_env_file).
ENV_FILE="$ZAGROS_HOME/.env"
LEGACY_ENV_FILE="$ZAGROS_HOME/zagros.env"
STATE_DIR="$ZAGROS_HOME/.state"
BACKUP_DIR="$ZAGROS_DATA/backups"
SERVICE="zagros"
DB_SERVICE="zagros-db"

# --------------------------------------------------------------------------- #
#  logging                                                                    #
# --------------------------------------------------------------------------- #
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[0;31m'; C_GRN=$'\033[0;32m'; C_YEL=$'\033[0;33m'
    C_BLU=$'\033[0;34m'; C_BLD=$'\033[1m';    C_RST=$'\033[0m'
    C_DIM=$'\033[2m';    C_PNK=$'\033[38;5;213m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_BLU=""; C_BLD=""; C_RST=""
    C_DIM=""; C_PNK=""
fi
log_info() { printf '%s[*]%s %s\n'  "$C_BLU" "$C_RST" "$*"; }
log_ok()   { printf '%s[✓]%s %s\n'  "$C_GRN" "$C_RST" "$*"; }
log_warn() { printf '%s[!]%s %s\n'  "$C_YEL" "$C_RST" "$*" >&2; }
log_err()  { printf '%s[✗]%s %s\n'  "$C_RED" "$C_RST" "$*" >&2; }
log_step() { printf '%s%s==>%s %s\n' "$C_BLD"  "$C_BLU" "$C_RST" "$*"; }
die()      { log_err "$*"; exit 1; }
confirm()  {  # confirm "question"; respects ASSUME_YES=1
    if [[ "${ASSUME_YES:-0}" == "1" ]]; then return 0; fi
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]
}

# --------------------------------------------------------------------------- #
#  prerequisites                                                              #
# --------------------------------------------------------------------------- #
require_root() { [[ "$(id -u)" -eq 0 ]] || die "this command must run as root (use sudo)."; }
require_cmd()  { command -v "$1" >/dev/null 2>&1 || die "required command '$1' is missing. $2"; }

_pkg_install() {  # _pkg_install <pkg...> — best-effort install across distros
    local pkgs=("$@")
    if   command -v apt-get >/dev/null 2>&1; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}"
    elif command -v dnf     >/dev/null 2>&1; then dnf install -y "${pkgs[@]}"
    elif command -v yum     >/dev/null 2>&1; then yum install -y "${pkgs[@]}"
    elif command -v zypper  >/dev/null 2>&1; then zypper --non-interactive install "${pkgs[@]}"
    elif command -v pacman  >/dev/null 2>&1; then pacman -Sy --noconfirm "${pkgs[@]}"
    elif command -v apk     >/dev/null 2>&1; then apk add --no-cache "${pkgs[@]}"
    else return 1; fi
}

ensure_cmd() {  # ensure_cmd <cmd> <pkg> — install if root, else actionable error
    local cmd="$1" pkg="$2"
    if command -v "$cmd" >/dev/null 2>&1; then return 0; fi
    if [[ "$(id -u)" -eq 0 ]] && _pkg_install "$pkg"; then
        command -v "$cmd" >/dev/null 2>&1 && return 0
    fi
    die "missing '$cmd' and automatic install failed — install package '$pkg' manually."
}

ensure_docker() {
    if command -v docker >/dev/null 2>&1; then return 0; fi
    [[ "${AUTO_INSTALL_DOCKER:-1}" == "1" ]] || die "docker is not installed and --no-docker-install was given. Install Docker: https://docs.docker.com/engine/install/"
    log_step "Docker not found — installing via the official get.docker.com script"
    require_cmd curl
    curl -fsSL https://get.docker.com -o /tmp/zagros-get-docker.sh
    sh /tmp/zagros-get-docker.sh
    rm -f /tmp/zagros-get-docker.sh
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable --now docker >/dev/null 2>&1 || true
    fi
    command -v docker >/dev/null 2>&1 || die "docker installation finished but 'docker' is still unavailable."
    log_ok "Docker installed: $(docker --version | head -1)"
}

compose_probe() {  # sets global COMPOSE=(...)
    if docker compose version >/dev/null 2>&1; then COMPOSE=(docker compose)
    elif command -v docker-compose >/dev/null 2>&1; then COMPOSE=(docker-compose)
    else die "Neither the Docker Compose plugin nor 'docker-compose' is available. Install the compose plugin: https://docs.docker.com/compose/install/linux/"; fi
}
compose()     { compose_probe
                # --env-file makes .env available for compose interpolation
                # (${ZAGROS_IMAGE_TAG}, db credentials). Without it, compose
                # auto-loads <project-dir>/.env — the same file — so degrade
                # gracefully during broken/uninstalled states.
                if [[ -f "$ENV_FILE" ]]; then
                    "${COMPOSE[@]}" -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
                else
                    "${COMPOSE[@]}" -f "$COMPOSE_FILE" "$@"
                fi }
panel_exec()  { compose exec -T "$SERVICE" "$@"; }
hostctl()     { panel_exec python3 -m app.platform.hostctl "$@"; }

# hostctl_json <args...> — runs hostctl, asserts ok:true, prints payload
hostctl_json() {
    ensure_cmd jq jq >/dev/null
    local out
    if ! out="$(hostctl "$@" 2>/dev/null)"; then
        hostctl "$@" >/dev/null 2>&1 || true
        die "panel operation failed: hostctl $* (panel container running? try: zagros status)"
    fi
    if [[ "$(printf '%s' "$out" | jq -r '.ok')" != "true" ]]; then
        printf '%s\n' "$out" | jq -r '"error: \(.error) [code: \(.code // "n/a")]"' >&2
        return 1
    fi
    printf '%s\n' "$out"
}

# --------------------------------------------------------------------------- #
#  env file helpers                                                           #
# --------------------------------------------------------------------------- #
env_get() {  # env_get KEY — value from $ENV_FILE (empty if absent).
             # NEVER fails: under `set -o pipefail`, a missing key makes
             # grep exit 1 → would abort any `x="$(env_get ...)"` caller.
    [[ -f "$ENV_FILE" ]] || { printf ''; return 0; }
    grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true
}
env_set() {  # env_set KEY VALUE — edits $ENV_FILE IN PLACE (inode kept)
    local key="$1" value="$2"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "invalid env key: $key"
    touch "$ENV_FILE"
    if grep -qE "^$key=" "$ENV_FILE"; then
        # sed -i replaces the file (new inode) — that would hide the edit
        # behind an existing bind-mount until the next recreate. Write
        # through the SAME inode instead, so a plain `compose restart`
        # (process re-exec) already sees the new value.
        local tmp="$ENV_FILE.tmp.$$"
        sed "s|^$key=.*|$key=$value|" "$ENV_FILE" > "$tmp" \
            && cat "$tmp" > "$ENV_FILE" && rm -f "$tmp"
    else
        printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
    fi
}
migrate_env_file() {  # legacy zagros.env → .env (idempotent, never fatal)
    [[ -f "$LEGACY_ENV_FILE" && ! -f "$ENV_FILE" ]] || return 0
    if [[ ! -d "$ZAGROS_HOME" || ! -w "$ZAGROS_HOME" ]]; then
        log_warn "legacy zagros.env found but $ZAGROS_HOME is not writable — run any zagros command as root to auto-migrate"
        return 0
    fi
    if cp -a "$LEGACY_ENV_FILE" "$ENV_FILE"; then
        chmod 600 "$ENV_FILE" 2>/dev/null || true
        mv "$LEGACY_ENV_FILE" "$LEGACY_ENV_FILE.migrated"
        log_warn "migrated legacy zagros.env → $ENV_FILE (kept as zagros.env.migrated)"
    else
        log_warn "automatic migration of $LEGACY_ENV_FILE failed — continuing without it"
    fi
    return 0
}
mask_secret() { local v="$1"; if ((${#v} > 8)); then printf '%s…%s' "${v:0:4}" "${v: -4}"; else printf '****'; fi; }
gen_secret() { openssl rand -hex "${1:-24}"; }

# --------------------------------------------------------------------------- #
#  versioning                                                                 #
# --------------------------------------------------------------------------- #
version_gt() {  # version_gt A B → true if A > B (dotted numeric compare)
    local a="${1#v}" b="${2#v}"
    local -a av bv
    IFS=. read -r -a av <<< "$a"
    IFS=. read -r -a bv <<< "$b"
    local i n=$((${#av[@]} > ${#bv[@]} ? ${#av[@]} : ${#bv[@]})) x y
    for ((i = 0; i < n; i++)); do
        x="${av[i]:-0}"; y="${bv[i]:-0}"
        x="${x%%[!0-9]*}"; y="${y%%[!0-9]*}"   # strip prerelease suffix per segment
        x="${x:-0}"; y="${y:-0}"
        ((10#$x > 10#$y)) && return 0
        ((10#$x < 10#$y)) && return 1
    done
    return 1
}

# resolve_version [stable|latest] — newest release tag from GitHub; falls back
# to the currently installed tag, then to the literal 'latest'
resolve_version() {
    local channel="${1:-stable}" json tag
    if json="$(curl -fsS --max-time 20 "$PANEL_API/releases?per_page=30" 2>/dev/null)"; then
        if [[ "$channel" == "stable" ]]; then
            tag="$(printf '%s' "$json" | jq -r '[.[] | select(.prerelease == false)][0].tag_name // empty' 2>/dev/null)"
        fi
        [[ -n "${tag:-}" ]] || tag="$(printf '%s' "$json" | jq -r '.[0].tag_name // empty' 2>/dev/null)"
        [[ -n "$tag" && "$tag" != "null" ]] && { printf '%s' "$tag"; return 0; }
    fi
    local cur
    cur="$(env_get ZAGROS_IMAGE_TAG)"
    [[ -n "$cur" ]] && { printf '%s' "$cur"; return 0; }
    printf 'latest'
}

ghcr_token() {
    curl -fsS --max-time 20 \
        "https://ghcr.io/token?service=ghcr.io&scope=repository:zagrosgm/zagros:pull" \
        | jq -r '.token'
}

ghcr_remote_digest() {  # ghcr_remote_digest <tag> → sha256:… (empty on failure)
    local tag="$1" token
    token="$(ghcr_token 2>/dev/null)" || return 1
    curl -fsSI --max-time 20 \
        -H "Authorization: Bearer $token" \
        -H "Accept: application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json" \
        "https://ghcr.io/v2/zagrosgm/zagros/manifests/$tag" 2>/dev/null \
        | grep -i '^docker-content-digest:' | awk '{print $2}' | tr -d '\r'
}

local_image_digest() {  # local_image_digest <tag> → sha256:… (empty if absent)
    docker image inspect "$IMAGE_REPO:$1" \
        --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null \
        | grep -m1 '^'"$IMAGE_REPO@" | sed "s|^$IMAGE_REPO@||"
}

# --------------------------------------------------------------------------- #
#  health                                                                     #
# --------------------------------------------------------------------------- #
wait_healthy() {  # wait_healthy <container> <seconds>
    local name="$1" deadline=$(( $(date +%s) + ${2:-120} )) status
    while (( $(date +%s) < deadline )); do
        status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$name" 2>/dev/null || echo missing)"
        case "$status" in
            healthy|running) return 0 ;;
            exited|dead|missing) return 1 ;;
        esac
        sleep 2
    done
    return 1
}

panel_version() { hostctl version 2>/dev/null | jq -r '.panel_version // "unknown"' 2>/dev/null || echo unknown; }

# --------------------------------------------------------------------------- #
#  compose templates (self-contained — no repo checkout needed)               #
# --------------------------------------------------------------------------- #
render_compose() {  # render_compose <db-kind> — writes $COMPOSE_FILE
    local db_kind="$1"
    local panel_svc db_svc
    panel_svc=$(cat <<'YAML'
services:
  zagros:
    # The tag is interpolated by compose from the ./.env file (--env-file),
    # so `zagros update` only needs to flip ZAGROS_IMAGE_TAG and re-pull.
    image: __IMAGE_REPO__:${ZAGROS_IMAGE_TAG:-latest}
    container_name: zagros
    restart: always
    network_mode: host
    # TUN-based cores (OpenVPN, WireGuard) run INSIDE this container: without
    # the tunnel device + NET_ADMIN their Start dies at interface creation
    # and the panel only sees the downstream symptom (management interface
    # unreachable / wg-quick dying). Grant both by default — additive and
    # inert when such cores are not used. IPv4 forwarding is applied on the
    # HOST by host_tun_preflight; compose sysctls cannot be used with host
    # network mode because that would mutate the host namespace.
    cap_add:
      - NET_ADMIN
      # Independent ACCEL-PPP PPTP uses GRE protocol 47 raw sockets.
      - NET_RAW
      # Per-outbound named network namespaces need mount/setns authority.
      # The panel still receives neither the Docker socket nor host PID access.
      - SYS_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
      - /dev/ppp:/dev/ppp
    # Configuration contract: compose only MOUNTS the .env file — NOTHING is
    # injected into the container environment, so the file is the only
    # configuration source. Edit ./.env (or `zagros config edit`), then
    # `zagros restart` applies every setting.
    volumes:
      - ./.env:/code/.env:ro
      - __DATA_DIR__:/var/lib/zagros
    healthcheck:
      # no env injection → the probe reads UVICORN_PORT from the mounted file
      test: ["CMD", "python3", "-c", "import ssl,urllib.request;d={l.split('=',1)[0].strip():l.split('=',1)[1].strip().strip(chr(34)).strip(chr(39)) for l in open('/code/.env',encoding='utf-8') if '=' in l and not l.lstrip().startswith('#')};p=str(int(d.get('UVICORN_PORT','8000')));m=d.get('TLS_MODE','auto');tls=m=='on' or (m=='auto' and bool(d.get('UVICORN_SSL_CERTFILE')) and bool(d.get('UVICORN_SSL_KEYFILE')));u=('https' if tls else 'http')+'://127.0.0.1:'+p+'/dashboard/';urllib.request.urlopen(u,timeout=3,context=ssl._create_unverified_context() if tls else None).close()"]
      interval: 20s
      timeout: 8s
      retries: 6
      start_period: 45s
YAML
)
    case "$db_kind" in
        mysql|mariadb)
            local img="mysql:8.4" ping="mysqladmin"
            # MariaDB 11 dropped the mysql*-named client symlinks, so its
            # image only ships mariadb-admin; probing with mysqladmin there
            # never succeeds and the database is declared unhealthy.
            [[ "$db_kind" == "mariadb" ]] && { img="mariadb:11.5"; ping="mariadb-admin"; }
            db_svc=$(cat <<YAML

  zagros-db:
    # Credentials live ONLY in ./.env (mode 600) — compose interpolates the
    # \${ZAGROS_DB_*} values from it; this file itself stays secret-free.
    image: $img
    container_name: zagros-db
    restart: always
    network_mode: host
    command: ["--port=\${ZAGROS_DB_PORT:-3306}", "--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci"]
    environment:
      MYSQL_ROOT_PASSWORD: \${ZAGROS_DB_ROOT_PASSWORD:?set ZAGROS_DB_ROOT_PASSWORD in .env}
      MYSQL_DATABASE: zagros
      MYSQL_USER: \${ZAGROS_DB_USER:-zagros}
      MYSQL_PASSWORD: \${ZAGROS_DB_PASSWORD:?set ZAGROS_DB_PASSWORD in .env}
    volumes:
      - __DATA_DIR__/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "$ping", "ping", "-h", "127.0.0.1", "--port=\${ZAGROS_DB_PORT:-3306}", "--silent", "--password=\${ZAGROS_DB_ROOT_PASSWORD:?set ZAGROS_DB_ROOT_PASSWORD in .env}"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 40s
YAML
)
            ;;
        postgresql)
            db_svc=$(cat <<'YAML'

  zagros-db:
    # Credentials live ONLY in ./.env (mode 600) — compose interpolates the
    # ${ZAGROS_DB_*} values from it; this file itself stays secret-free.
    image: postgres:17
    container_name: zagros-db
    restart: always
    network_mode: host
    command: ["-p", "${ZAGROS_DB_PORT:-5432}"]
    environment:
      POSTGRES_DB: zagros
      POSTGRES_USER: ${ZAGROS_DB_USER:-zagros}
      POSTGRES_PASSWORD: ${ZAGROS_DB_PASSWORD:?set ZAGROS_DB_PASSWORD in .env}
    volumes:
      - __DATA_DIR__/db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${ZAGROS_DB_USER:-zagros} -d zagros -p ${ZAGROS_DB_PORT:-5432} -h 127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
YAML
)
            ;;
        *) db_svc="" ;;
    esac
    printf '%s%s\n' "$panel_svc" "$db_svc" > "$COMPOSE_FILE.tmp"
    sed -i \
        -e "s|__IMAGE_REPO__|$IMAGE_REPO|g" \
        -e "s|__DATA_DIR__|$ZAGROS_DATA|g" \
        "$COMPOSE_FILE.tmp"
    mv "$COMPOSE_FILE.tmp" "$COMPOSE_FILE"
    chmod 640 "$COMPOSE_FILE"
}

render_env() {  # render_env <db-kind> <image-tag> — writes the full $ENV_FILE
    local db_kind="$1" tag="$2"
    local secret legacy_url platform_url db_port="" db_user="" db_pass="" db_root=""
    secret="$(gen_secret 32)"
    case "$db_kind" in
        sqlite)
            platform_url="sqlite:////var/lib/zagros/zagros.db"
            legacy_url="sqlite:////var/lib/zagros/legacy.db"
            ;;
        mysql|mariadb)
            db_port="${ZAGROS_DB_PORT:-3306}"
            db_user="zagros"; db_pass="$(gen_secret 16)"; db_root="$(gen_secret 16)"
            platform_url="mysql+pymysql://zagros:${db_pass}@127.0.0.1:${db_port}/zagros?charset=utf8mb4"
            legacy_url="mysql+pymysql://zagros:${db_pass}@127.0.0.1:${db_port}/zagros_legacy?charset=utf8mb4"
            ;;
        postgresql)
            db_port="${ZAGROS_DB_PORT:-5432}"
            db_user="zagros"; db_pass="$(gen_secret 16)"
            platform_url="postgresql+psycopg://zagros:${db_pass}@127.0.0.1:${db_port}/zagros"
            legacy_url="postgresql+psycopg://zagros:${db_pass}@127.0.0.1:${db_port}/zagros_legacy"
            ;;
        *) die "unknown database kind: $db_kind (expected sqlite|mysql|mariadb|postgresql)" ;;
    esac
    cat > "$ENV_FILE" <<EOF
# ════════════════════════════════════════════════════════════════════════
#  Zagros configuration — THE single source of truth (.env)
#  Generated by zagros $ZAGROS_CLI_VERSION on $(date -u +%Y-%m-%dT%H:%M:%SZ)
#  Keep this file private (mode 600) — it contains database credentials
#  and the platform's master secret.
#
#  docker compose only MOUNTS this file (./.env → /code/.env) — nothing is
#  baked into the image, so editing this file + restarting applies it all:
#
#    interactive editor    zagros config edit
#    one key               zagros config set KEY VALUE [--restart]
#    apply every change    zagros restart          (recreates the panel)
#    quick apply (in-place edits) zagros config reload
#    overview (masked)     zagros config show
# ════════════════════════════════════════════════════════════════════════

# ── installer bookkeeping (used by the zagros CLI / compose, not the panel)
ZAGROS_IMAGE_TAG=$tag
ZAGROS_DB_KIND=$db_kind

# ── identity / domain ──
# Public hostname of this panel — once set, PANEL_BASE_URL / APP_BASE_URL
# and absolute subscription links are derived from it automatically.
# DOMAIN=panel.example.com
# PANEL_BASE_URL=https://panel.example.com
# APP_BASE_URL=https://panel.example.com

# ── HTTP bind & TLS ──
# The bind host is honored VERBATIM — nothing in the runtime rewrites it.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=${UVICORN_PORT:-8000}
# TLS_MODE: auto | on | off
#   auto = TLS when both SSL files below are set, otherwise plain HTTP
#   on   = TLS required — the panel refuses to boot without cert+key
#   off  = force plain HTTP (a reverse proxy terminates TLS upstream)
TLS_MODE=auto
# UVICORN_SSL_CERTFILE=/var/lib/zagros/certs/fullchain.pem
# UVICORN_SSL_KEYFILE=/var/lib/zagros/certs/key.pem
# UVICORN_SSL_CA_CERTFILE=/var/lib/zagros/certs/ca.pem
# UVICORN_SSL_CA_TYPE=public
# UVICORN_UDS=

# ── database ──
ZAGROS_DATABASE_URL=$platform_url
SQLALCHEMY_DATABASE_URL=$legacy_url
# SQLALCHEMY_POOL_SIZE=10
# SQLIALCHEMY_MAX_OVERFLOW=30

# ── security ──
ZAGROS_SECRET_KEY=$secret
# CORS allow-list (comma separated; empty = same-origin only, never "*")
ALLOWED_ORIGINS=
# HTTP Host-header allow-list (comma separated; empty = no restriction)
TRUSTED_HOSTS=

# ── dashboard ──
DASHBOARD_PATH=/dashboard/

# ── subscription ──
# SUBSCRIPTION_URL_PREFIX=https://panel.example.com   (default: from DOMAIN)
# SUBSCRIPTION_PATH=sub
# SUBSCRIPTION_TEMPLATE=subscription/index.html
# SUB_PROFILE_TITLE=Subscription
# SUB_SUPPORT_URL=https://t.me/support
# SUB_UPDATE_INTERVAL=12

# ── client app / branding ──
ZAGROS_PORTAL_TITLE=اشتراک من
ZAGROS_APP_NAME=Zagros
# ZAGROS_CLIENT_AUTH_MODE=subscription_link

# ── drivers / cores ──
# Xray binary, assets and accepted Studio document live on the mounted data
# tree, so image replacement cannot silently reset listeners or require an
# install/update action.
XRAY_JSON=/var/lib/zagros/cores/xray/xray_config.json
XRAY_EXECUTABLE_PATH=/var/lib/zagros/cores/xray/bin/xray
XRAY_ASSETS_PATH=/var/lib/zagros/cores/xray/assets
# Additional cores are managed from the panel/CLI (zagros list-cores) —
# their settings live in the database, not here.
# DISABLE_RECORDING_NODE_USAGE=false

