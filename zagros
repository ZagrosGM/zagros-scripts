}

db_client() {  # db_client <shell|dump> — the client binary for the active engine
    # MariaDB 11 removed the mysql*-named client symlinks, so the MariaDB
    # image ships only mariadb / mariadb-dump / mariadb-admin. MySQL keeps
    # the historical names. Both clients honour MYSQL_PWD.
    if [[ "$(env_get ZAGROS_DB_KIND)" == "mariadb" ]]; then
        case "$1" in dump) printf 'mariadb-dump' ;; *) printf 'mariadb' ;; esac
    else
        case "$1" in dump) printf 'mysqldump' ;; *) printf 'mysql' ;; esac
    fi
}

provision_legacy_db() {  # second database on the managed db server
    local db_kind; db_kind="$(env_get ZAGROS_DB_KIND)"
    case "$db_kind" in
        mysql|mariadb)
            local root_pw
            root_pw="$(env_get ZAGROS_DB_ROOT_PASSWORD)"
            docker exec -e MYSQL_PWD="$root_pw" "$DB_SERVICE" \
                "$(db_client shell)" -h127.0.0.1 --port="$(env_get ZAGROS_DB_PORT)" -uroot \
                -e "CREATE DATABASE IF NOT EXISTS zagros_legacy CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; GRANT ALL PRIVILEGES ON zagros_legacy.* TO '$(env_get ZAGROS_DB_USER)'@'%'; FLUSH PRIVILEGES;"
            ;;
        postgresql)
            docker exec -e PGPASSWORD="$(env_get ZAGROS_DB_PASSWORD)" "$DB_SERVICE" \
                psql -h127.0.0.1 -p "$(env_get ZAGROS_DB_PORT)" -U "$(env_get ZAGROS_DB_USER)" -d zagros -tAc \
                "SELECT 1 FROM pg_database WHERE datname='zagros_legacy'" | grep -q 1 \
            || docker exec -e PGPASSWORD="$(env_get ZAGROS_DB_PASSWORD)" "$DB_SERVICE" \
                psql -h127.0.0.1 -p "$(env_get ZAGROS_DB_PORT)" -U "$(env_get ZAGROS_DB_USER)" -d zagros -c \
                "CREATE DATABASE zagros_legacy"
            ;;
    esac
}

install_cli_file() {  # install_cli_file — place the running CLI into $ZAGROS_BIN
    local target="$ZAGROS_BIN/zagros"
    mkdir -p "$ZAGROS_BIN"
    # Idempotency: the bootstrap one-liner already placed the running script
    # at $target — GNU install(1) fails with "are the same file" when src and
    # dst share an inode, so refresh the mode and treat it as done.
    local src=""
    if [[ -n "${ZAGROS_CLI_SELF:-}" && -r "$ZAGROS_CLI_SELF" ]]; then
        src="$ZAGROS_CLI_SELF"
    elif [[ "${BASH_SOURCE[0]}" == */zagros && -r "${BASH_SOURCE[0]}" ]]; then
        src="${BASH_SOURCE[0]}"
    fi
    if [[ -n "$src" ]]; then
        if [[ -e "$target" && "$src" -ef "$target" ]]; then
            chmod 0755 "$target"
        else
            install -m 0755 "$src" "$target"
        fi
    else
        curl -fsSL "$SCRIPTS_REPO_RAW/$ZAGROS_SCRIPTS_REF/zagros" -o "$target"
        chmod 0755 "$target"
    fi
    log_ok "CLI installed → $target"
}

wait_ssh_accounting_snapshot() {
    # A running systemd unit is not enough: the Panel consumes this heartbeat.
    # Bound the wait so install-host-agent reports the real failure instead of
    # printing success while Core Settings stays degraded indefinitely.
    local state="$ZAGROS_DATA/cores/ssh/host-transport-usage.json"
    local i
    for i in $(seq 1 40); do
        if python3 - "$state" <<'PYEOF' 2>/dev/null
import json, os, sys, time
path = sys.argv[1]
raw = json.load(open(path, encoding="utf-8"))
assert raw.get("version") == 1 and isinstance(raw.get("totals"), dict)
assert time.time() - os.path.getmtime(path) <= 5
PYEOF
        then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

install_host_agent_files() {
    # The CLI harness relocates SYSTEMD_DIR into a sandbox. Do not contact the
    # network or the real systemd daemon there; production uses the canonical
    # path (manual tests may opt in explicitly).
    if [[ "$SYSTEMD_DIR" != "/etc/systemd/system" && "${ZAGROS_FORCE_HOST_AGENT:-0}" != 1 ]]; then
        log_info "host network agent skipped outside the production systemd path"
        return 0
    fi
    local target="$ZAGROS_LIBEXEC/zagros-host-agent" source=""
    local acct_target="$ZAGROS_LIBEXEC/zagros-ssh-accounting-agent" acct_source=""
    mkdir -p "$ZAGROS_LIBEXEC" "$SYSTEMD_DIR" "$ZAGROS_DATA/host-actions" \
        "$ZAGROS_DATA/cores/ssh"
    chmod 700 "$ZAGROS_DATA/host-actions"
    if [[ -r "$(dirname "${BASH_SOURCE[0]}")/zagros-host-agent" ]]; then
        source="$(dirname "${BASH_SOURCE[0]}")/zagros-host-agent"
        install -m 0755 "$source" "$target"
    else
        curl -fsSL "$SCRIPTS_REPO_RAW/$ZAGROS_SCRIPTS_REF/zagros-host-agent" -o "$target"
        chmod 0755 "$target"
    fi
    if [[ -r "$(dirname "${BASH_SOURCE[0]}")/zagros-ssh-accounting-agent" ]]; then
        acct_source="$(dirname "${BASH_SOURCE[0]}")/zagros-ssh-accounting-agent"
        install -m 0755 "$acct_source" "$acct_target"
    else
        curl -fsSL "$SCRIPTS_REPO_RAW/$ZAGROS_SCRIPTS_REF/zagros-ssh-accounting-agent" -o "$acct_target"
        chmod 0755 "$acct_target"
    fi
    cat > "$SYSTEMD_DIR/zagros-host-agent.service" <<EOF
[Unit]
Description=Zagros host network apply agent
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=$target
EOF
    cat > "$SYSTEMD_DIR/zagros-host-agent.path" <<EOF
[Unit]
Description=Watch Zagros host network requests

[Path]
PathChanged=$ZAGROS_DATA/host-actions/panel-network.request.json
Unit=zagros-host-agent.service

[Install]
WantedBy=multi-user.target
EOF

    # A restore writes a restart request (the panel cannot restart itself);
    # the same agent handles it, so one service owns every privileged action.
    cat > "$SYSTEMD_DIR/zagros-host-agent-restart.path" <<EOF
[Unit]
Description=Watch Zagros host restart requests

[Path]
PathChanged=$ZAGROS_DATA/host-actions/panel-restart.request.json
Unit=zagros-host-agent.service

[Install]
WantedBy=multi-user.target
EOF
    cat > "$SYSTEMD_DIR/zagros-ssh-accounting.service" <<EOF
[Unit]
Description=Zagros read-only SSH transport accounting collector
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=$acct_target
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=$ZAGROS_DATA/cores/ssh
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
RestrictAddressFamilies=AF_NETLINK AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 "$SYSTEMD_DIR/zagros-host-agent.service" \
        "$SYSTEMD_DIR/zagros-host-agent.path" \
        "$SYSTEMD_DIR/zagros-ssh-accounting.service"
    # Readiness is a runtime fact, not merely "files were copied". A stale
    # marker on a non-systemd host would let the panel queue an operation that
    # nobody can consume, leaving Apply pending forever.
    rm -f "$ZAGROS_DATA/host-actions/.agent-ready"
    # `enable --now` is a no-op for an already-active service. That is unsafe
    # after update/uninstall recreated cores/ssh: systemd's ReadWritePaths bind
    # still points at the deleted directory inode, so the old collector writes
    # an invisible heartbeat. Restart both units to load the new binaries/units
    # and enter a fresh mount namespace rooted at the persistent directories.
    if [[ "$SYSTEMD_DIR" == "/etc/systemd/system" ]] \
            && command -v systemctl >/dev/null 2>&1 \
            && [[ -d /run/systemd/system ]] \
            && systemctl daemon-reload \
            && systemctl enable --now zagros-host-agent.path \
                zagros-host-agent-restart.path \
                zagros-ssh-accounting.service >/dev/null \
            && systemctl restart zagros-ssh-accounting.service \
            && systemctl restart zagros-host-agent.path \
            && systemctl restart zagros-host-agent-restart.path \
            && systemctl is-active --quiet zagros-host-agent.path \
            && systemctl is-active --quiet zagros-ssh-accounting.service \
            && wait_ssh_accounting_snapshot; then
        # The restart watcher is additive: an older agent without it keeps
        # Panel Network working, it just cannot restart after a restore.
        systemctl is-active --quiet zagros-host-agent-restart.path \
            || log_warn "restart watcher inactive — a restore will ask you to run \`zagros restart\` by hand"
        touch "$ZAGROS_DATA/host-actions/.agent-ready"
        chmod 0600 "$ZAGROS_DATA/host-actions/.agent-ready"
        # The panel decides whether the host can restart it by reading this
        # file, and the agent only writes it when it runs. Publish it here so
        # a restore can ask for a restart immediately after an install.
        printf '%s\n' '{"version":2,"actions":["apply-network","restart-panel"]}' \
            > "$ZAGROS_DATA/host-actions/.agent-capabilities"
        chmod 0644 "$ZAGROS_DATA/host-actions/.agent-capabilities"
        log_ok "host agents active; SSH accounting heartbeat is fresh"
    else
        if [[ "$SYSTEMD_DIR" != "/etc/systemd/system" ]]; then
            log_warn "host network agent files installed but path watcher is inactive; Panel Network Apply stays disabled until systemd activation succeeds"
            return 0
        fi
        log_err "host-agent verification failed: path watcher, SSH collector, or fresh accounting heartbeat is unavailable"
        log_warn "Panel Network Apply remains disabled and SSH Core Settings will name the missing/stale snapshot until this is fixed"
        return 1
    fi
}

cmd_install_host_agent() {
    require_root
    require_installed
    install_host_agent_files
}

