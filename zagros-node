#!/usr/bin/env bash
# Native Zagros Node installer/lifecycle CLI. No Docker socket is mounted into
# the agent; the container manages only its own child core processes.
set -euo pipefail

NODE_HOME="${ZAGROS_NODE_HOME:-/opt/zagros-node}"
NODE_DATA="${ZAGROS_NODE_DATA:-/var/lib/zagros-node}"
IMAGE="${ZAGROS_NODE_IMAGE:-ghcr.io/zagrosgm/zagros:v1.0.0-alpha.8.8}"
PORT="${ZAGROS_NODE_PORT:-62050}"

need_root() { [[ $EUID -eq 0 ]] || { echo "zagros-node requires root" >&2; exit 1; }; }
need() { command -v "$1" >/dev/null || { echo "required tool missing: $1" >&2; exit 1; }; }

write_compose() {
  local registration_hash="$1"
  cat > "$NODE_HOME/docker-compose.yml" <<EOF
services:
  zagros-node:
    image: $IMAGE
    container_name: zagros-node
    restart: always
    network_mode: host
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    command: ["python", "-m", "app.node_agent"]
    environment:
      ZAGROS_NODE_DATA: /var/lib/zagros-node
      ZAGROS_NODE_PORT: "$PORT"
      ZAGROS_NODE_TLS_CERT: /var/lib/zagros-node/tls/node.crt
      ZAGROS_NODE_TLS_KEY: /var/lib/zagros-node/tls/node.key
      ZAGROS_NODE_REGISTRATION_HASH: "$registration_hash"
    volumes:
      - $NODE_DATA:/var/lib/zagros-node
      - $NODE_DATA/cores-runtime:/var/lib/zagros
EOF
  chmod 600 "$NODE_HOME/docker-compose.yml"
}

install_node() {
  need_root; need docker; need openssl; need python3
  local host="${1:-}" token hash san
  [[ -n "$host" ]] || { echo "usage: zagros-node install <certificate-dns-or-ip> [port]" >&2; exit 2; }
  PORT="${2:-$PORT}"
  [[ "$PORT" =~ ^[0-9]+$ && "$PORT" -ge 1 && "$PORT" -le 65535 ]] \
    || { echo "invalid node port" >&2; exit 2; }
  mkdir -p "$NODE_HOME" "$NODE_DATA/tls" "$NODE_DATA/cores-runtime"
  chmod 700 "$NODE_HOME" "$NODE_DATA" "$NODE_DATA/tls" "$NODE_DATA/cores-runtime"
  token="$(openssl rand -base64 32 | tr -d '\n')"
  hash="$(printf '%s' "$token" | sha256sum | cut -d' ' -f1)"
  if python3 - "$host" <<'PY' >/dev/null 2>&1
import ipaddress,sys
ipaddress.ip_address(sys.argv[1])
PY
  then san="IP:$host"; else san="DNS:$host"; fi
  openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
    -subj "/CN=$host/O=Zagros Node" -addext "subjectAltName=$san" \
    -keyout "$NODE_DATA/tls/node.key" -out "$NODE_DATA/tls/node.crt" >/dev/null 2>&1
  chmod 600 "$NODE_DATA/tls/node.key" "$NODE_DATA/tls/node.crt"
  write_compose "$hash"
  cd "$NODE_HOME"
  docker compose up -d
  fingerprint="$(openssl x509 -in "$NODE_DATA/tls/node.crt" -outform der | sha256sum | cut -d' ' -f1)"
  cat <<EOF
Zagros Node started on https://$host:$PORT
One-time registration token (shown once; only its SHA-256 is stored):
$token
TLS SHA-256 fingerprint:
$fingerprint
EOF
}

case "${1:-}" in
  install) shift; install_node "$@" ;;
  start|restart|stop)
    need_root; need docker; cd "$NODE_HOME"; docker compose "$1" ;;
  status)
    need docker; cd "$NODE_HOME"; docker compose ps ;;
  logs)
    need docker; cd "$NODE_HOME"; docker compose logs --tail "${2:-200}" zagros-node ;;
  uninstall)
    need_root; need docker; cd "$NODE_HOME"; docker compose down --remove-orphans || true
    rm -rf "$NODE_HOME"
    echo "Node container removed. Identity/core data remains at $NODE_DATA; remove it explicitly after revoking the node in Panel." ;;
  *) echo "usage: zagros-node {install <dns-or-ip> [port]|start|stop|restart|status|logs [n]|uninstall}" >&2; exit 2 ;;
esac
